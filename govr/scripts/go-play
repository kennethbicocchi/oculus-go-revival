#!/usr/bin/env bash
# go-play <game> : start a Steam game in VR mode (needs a running `go-start vr` session).
#   go-play nms | 275850     No Man's Sky with its VR launch option (-HmdEnable 1)
#   go-play forest | 242760  The Forest VR
#   go-play <appid>          any other Steam app through its VR launch option
#                            (steam://launch/<id>/VR, what SteamVR's own library uses)
#   go-play <appid> <args>   any Steam app id with explicit arguments (steam -applaunch)
# Why: steam -applaunch and plain steam:// links use the game's *default* launch option,
# which for No Man's Sky is the flat one — SteamVR then shows it on a flat screen.
set -euo pipefail
# Close the SteamVR dashboard first: while it is open GoVR's virtual pointer controller is
# connected, and a game that starts with a VR controller present may ignore the gamepad.
vrcmd="$HOME/.local/share/Steam/steamapps/common/SteamVR/bin/linux64/vrcmd"
if [[ -n "${1:-}" ]] && pgrep -x vrserver >/dev/null && [[ -x "$vrcmd" ]]; then
  (cd "$(dirname "$vrcmd")" && LD_LIBRARY_PATH=. timeout 5 ./vrcmd --hidedashboard >/dev/null 2>&1) || true
  sleep 1
fi
case "${1:-}" in
  nms|nomanssky|275850) [[ $# -le 1 ]] && set -- 275850 -HmdEnable 1 ;;
  forest|theforest) set -- 242760 ;;
  "") sed -n '2,9p' "$0"; exit 2 ;;
esac
pgrep -x vrserver >/dev/null || echo "note: SteamVR is not running — start it first with: go-start vr" >&2
app="$1"; shift
[[ $# -eq 0 ]] && exec steam "steam://launch/$app/VR"
exec steam -applaunch "$app" "$@"
