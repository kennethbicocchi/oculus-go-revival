#!/usr/bin/env bash
# go-steamvr [--audio-default] [--mute-pc]: SteamVR on the Oculus Go through ALVR v20.14.1 over USB.
#  1. wakes the headset and starts the GoVR client (if needed)
#  2. writes ~/.config/alvr/session.json for the Go (first run, or with GOVR_ALVR_RESET=1)
#  3. registers the ALVR driver with SteamVR
#  4. runs the GoVR desktop/audio server: ALL PC audio goes to the headset during the session
#     (desktop screen available on top of SteamVR with govr-ctl overlay / gamepad Back)
#  5. starts the ALVR dashboard (server UI, compositor wrapper, driver unblock) and SteamVR
#     through vrmonitor.sh (outside the Steam Runtime container, see make_session.py)
set -euo pipefail
source "$(dirname "$0")/common.sh"
ALVR="$GO_ROOT/toolchain/alvr_streamer_linux"
[[ -x "$ALVR/bin/alvr_dashboard" ]] || die "ALVR streamer missing in $ALVR"
find_steamvr() {
  local vdf="$HOME/.local/share/Steam/steamapps/libraryfolders.vdf" p
  for p in $(grep -oE '"path"\s+"[^"]+"' "$vdf" 2>/dev/null | cut -d'"' -f4); do
    [[ -x "$p/steamapps/common/SteamVR/bin/vrpathreg.sh" ]] && { echo "$p/steamapps/common/SteamVR"; return; }
  done
}
STEAMVR="$(find_steamvr || true)"
[[ -n "$STEAMVR" ]] || die "SteamVR is not installed (see NEEDS_USER.md: steam steam://install/250820)"

"$GO_ROOT/scripts/go-up" >/dev/null
adb reverse tcp:9950 tcp:9950 >/dev/null
focus=$(adb shell dumpsys window windows | grep mCurrentFocus)
[[ "$focus" == *com.govr.client* ]] || "$GO_ROOT/scripts/go-launch" com.govr.client/.MainActivity >/dev/null

SESSION="$HOME/.config/alvr/session.json"
if [[ ! -f "$SESSION" || "${GOVR_ALVR_RESET:-0}" == 1 ]]; then
  [[ -f "$SESSION" ]] && cp "$SESSION" "$SESSION.bak-$(ts)"
  python3 "$GO_ROOT/pc/alvr/make_session.py" "$SESSION"
fi
"$STEAMVR/bin/vrpathreg.sh" adddriver "$ALVR/lib64/alvr" >/dev/null 2>&1 || true

# audio options from go-start (default: everything to the headset)
audio_args=("$@"); [[ $# -eq 0 ]] && audio_args=(--audio-default)
"$GO_ROOT/.venv-srv/bin/python" "$GO_ROOT/pc/govr_server.py" --source kwin --output "${GOVR_OUTPUT:-DP-3}" \
  "${audio_args[@]}" --no-adb --log "$LOGS/steamvr-govr-$(ts).txt" &
srv=$!
trap 'kill $srv 2>/dev/null' EXIT
pgrep -x steam >/dev/null || pgrep -f 'ubuntu12_32/steam' >/dev/null || { steam -silent >/dev/null 2>&1 & sleep 15; }
"$ALVR/bin/alvr_dashboard" > "$LOGS/alvr-dashboard-$(ts).txt" 2>&1 &
dash=$!
trap 'kill $srv $dash 2>/dev/null' EXIT
sleep 5   # let the dashboard install its compositor wrapper / unblock the driver
echo "starting SteamVR; close SteamVR (or Ctrl+C) to end the session"
# QT_QPA_PLATFORM=xcb: vrmonitor's Qt UI must use XWayland on KDE Wayland (ALVR wiki)
QT_QPA_PLATFORM=xcb "$STEAMVR/bin/vrmonitor.sh" > "$LOGS/steamvr-$(ts).txt" 2>&1 || true
